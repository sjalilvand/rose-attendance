APP_VERSION=1.0.0

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=attendance.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.com,http://localhost

DB_NAME=rose_attendance
DB_USER=rose_app

BUSINESS_TIME_ZONE=Asia/Tehran

# Retention policy (activate cleanup only after policy approval)
RETENTION_MONTHS=3
OFFLINE_NORMAL_WINDOW_DAYS=7
# CLEANUP_ENABLED=False

# ---- SSO (ورود یکپارچهٔ سازمانی — OpenID Connect) --------------------------
# با پر کردن این پنج مقدار، دکمهٔ «ورود با سامانهٔ سازمانی» در صفحهٔ ورود PWA
# فعال می‌شود. نمونه برای Keycloak/Azure/Google در docs/GUIDE.md بخش ۵٫۱.
# Callback URI که باید در ارائه‌دهنده ثبت شود:
#   https://<دامنهٔ شما>/api/v1/auth/sso/callback/
#SSO_ENABLED=1
#SSO_ISSUER=https://sso.example.com/realms/rose
#SSO_CLIENT_ID=rose-attendance
#SSO_CLIENT_SECRET=change-me
#SSO_LABEL=سامانهٔ سازمانی
# ساخت خودکار حساب برای کاربر تازه: 1=فعال (پیش‌فرض) 0=غیرفعال
#SSO_AUTO_PROVISION=1
# ایمیل‌هایی که با SSO وارد شوند ادمین سیستم شوند (جداشده با ویرگول)
#SSO_ADMIN_EMAILS=
